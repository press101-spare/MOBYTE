  dialogues:
  - speaker: Palyer
    text: "\uB0B4 \uB3C8\uC8FC\uBA38\uB2C8!!"
    background: {fileID: 8928819508324684010, guid: 149f8f50117506a48a67a8dda65f227e,
      type: 3}
    nextIndex: -1
    choices: []
  - speaker: Palyer
    text: "\uC0AC\uB77C\uC84C\uC796\uC544..."
    background: {fileID: 8928819508324684010, guid: 149f8f50117506a48a67a8dda65f227e,
      type: 3}
    nextIndex: -1
    choices: []
  - speaker: "\uD574\uC124"
    text: "**\uB3C8\uC8FC\uBA38\uB2C8\uB97C \uC783\uC5B4 \uBC84\uB838\uB2E4**"
    background: {fileID: 8928819508324684010, guid: 149f8f50117506a48a67a8dda65f227e,
      type: 3}
    nextIndex: -1
    choices:
    - choiceText: "\uC783\uC5B4\uBC84\uB838\uB2E4"
      nextIndex: -2
      effects:
      - {fileID: 2026090837}
  endEffects: []
  randomDialogueList:
  - eventName: "\uC8FC\uC0AC\uC704 \uC99D\uC815!"
    background: {fileID: 8806969880016095725, guid: d2147dcacced83c4bb4bef5068d8b403,
      type: 3}
    dialogues:
    - speaker: "\uD574\uC124"
      text: "\uAE38\uAC00\uC5D0 \uB193\uC778 \uC791\uC740 \uC120\uBB3C \uC0C1\uC790\uC5D0\uC11C
        \uD76C\uBBF8\uD55C \uBE5B\uC774 \uC0C8\uC5B4 \uB098\uC628\uB2E4."
      background: {fileID: 0}
      nextIndex: -1
      choices: []
    - speaker: Player
      text: "\uC0C1\uC790 \uC548\uC5D0 \uC8FC\uC0AC\uC704\uAC00 \uB4E4\uC5B4 \uC788\uC796\uC544?"
      background: {fileID: 0}
      nextIndex: -1
      choices: []
    - speaker: "\uD574\uC124"
      text: "\uB204\uAD70\uAC00 \uB0A8\uACA8 \uB454 \uD2B9\uBCC4\uD55C \uC8FC\uC0AC\uC704\uC778
        \uAC83 \uAC19\uB2E4."
      background: {fileID: 0}
      nextIndex: -1
      choices:
      - choiceText: "\uC8FC\uC0AC\uC704\uB97C \uCC59\uAE34\uB2E4"
        nextIndex: -2
        effects:
        - {fileID: 2026090842}
    endEffects: []
  - eventName: "\uC0BC\uC9C0\uC120\uB2E4 \uC120\uD0DD\uC9C0"
    background: {fileID: 5233048643400102705, guid: cadc97535446cd34db59dc23d05711e4,
      type: 3}
    dialogues:
    - speaker: "\uC0C1\uC778"
      text: "\uC624\uB298 \uD558\uB8E8\uB9CC \uD2B9\uBCC4 \uD560\uC778\uC785\uB2C8\uB2E4!"
      background: {fileID: 0}
      nextIndex: -1
      choices: []
    - speaker: Player
      text: "\uC815\uB9D0 \uC774 \uAC00\uACA9\uC5D0 \uD30C\uB294 \uAC74\uAC00\uC694?"
      background: {fileID: 0}
      nextIndex: -1
      choices: []
    - speaker: "\uC0C1\uC778"
      text: "\uC138 \uAC1C \uC911 \uD558\uB098\uB9CC \uACE0\uB974\uC138\uC694. \uC0C1\uC810\uBCF4\uB2E4
        20% \uC2F8\uAC8C \uB4DC\uB9AC\uC8E0."
      background: {fileID: 0}
      nextIndex: -1
      choices:
      - choiceText: "\uC9DD\uC218 \uC8FC\uC0AC\uC704 - 40\uCE69"
        nextIndex: -2
        effects:
        - {fileID: 2026090839}
      - choiceText: "\uD640\uC218 \uC8FC\uC0AC\uC704 - 40\uCE69"
        nextIndex: -2
        effects:
        - {fileID: 2026090840}
      - choiceText: "\uBC29\uC5B4 \uC8FC\uC0AC\uC704 - 40\uCE69"
        nextIndex: -2
        effects:
        - {fileID: 2026090841}
      - choiceText: "\uC9C0\uB098\uCE5C\uB2E4"
        nextIndex: -2
        effects:
        - {fileID: 1531438039}
    endEffects: []
  - eventName: "\uC88B\uC544 \uB354\uBE14\uB85C\uAC00"
    background: {fileID: -2784226545802003085, guid: 490414c90d55e334ab02c726d9112d02,
      type: 3}
    dialogues:
    - speaker: "\uD574\uC124"
      text: "\uB450 \uAC1C\uC758 \uC218\uC0C1\uD55C \uC8FC\uC0AC\uC704\uAC00 \uD14C\uC774\uBE14
        \uC704\uC5D0\uC11C \uBE5B\uB098\uACE0 \uC788\uB2E4."
      background: {fileID: 0}
      nextIndex: -1
      choices: []
    - speaker: "\uB3C4\uBC15\uC0AC"
      text: "\uC6B4\uC774 \uC88B\uB2E4\uBA74 \uB450 \uBC30, \uC544\uC8FC \uC88B\uB2E4\uBA74
        \uC138 \uBC30\uAC00 \uB418\uC9C0."
      background: {fileID: 0}
      nextIndex: -1
      choices: []
    - speaker: Player
      text: "\uC704\uD5D8\uD574 \uBCF4\uC774\uC9C0\uB9CC \uC2DC\uD5D8\uD574 \uBCFC
        \uAC00\uCE58\uB294 \uC788\uACA0\uC5B4."
      background: {fileID: 0}
      nextIndex: -1
      choices:
      - choiceText: "\uC8FC\uC0AC\uC704\uB97C \uAD74\uB9B0\uB2E4"
        nextIndex: -2
        effects:
        - {fileID: 2026090844}
    endEffects: []
  - eventName: Flax~!
    background: {fileID: -54778319253412893, guid: b7da1a0b9d326504b98c173dc8297c28,
      type: 3}
    dialogues:
    - speaker: "\uD574\uC124"
      text: "\uB108\uBB34 \uC2E0\uB098\uAC8C \uB180\uC544\uBC84\uB838\uB2E4. \uACC4\uC0B0\uC11C\uAC00
        \uBD88\uC548\uD558\uAC8C \uD754\uB4E4\uB9AC\uACE0 \uC788\uB2E4."
      background: {fileID: 0}
      nextIndex: -1
      choices: []
    - speaker: Player
      text: "\uC124\uB9C8 \uC774\uB807\uAC8C \uB9CE\uC774 \uC37C\uC744 \uB9AC\uB294
        \uC5C6\uACA0\uC9C0...?"
      background: {fileID: 0}
      nextIndex: -1
      choices: []
    - speaker: "\uD574\uC124"
      text: "\uAC00\uC9C4 \uB3C8\uC758 50%\uB97C \uC9C0\uBD88\uD574\uC57C \uD55C\uB2E4."
      background: {fileID: 0}
      nextIndex: -1
      choices:
      - choiceText: "\uACC4\uC0B0\uD55C\uB2E4"
        nextIndex: -2
        effects:
        - {fileID: 2026090847}
    endEffects: []
  - eventName: "\uB3C8\uC8FC\uBA38\uB2C8\uB97C \uC783\uC5B4\uBC84\uB838\uC5B4\u3160\u3160"
    background: {fileID: -7332996254234084354, guid: eb848eb4a4d202844b44fe954fd1aa1a,
      type: 3}
    dialogues:
    - speaker: Player
      text: "\uB0B4 \uB3C8\uC8FC\uBA38\uB2C8!!"
      background: {fileID: 0}
      nextIndex: -1
      choices: []
    - speaker: Player
      text: "\uBD84\uBA85 \uC870\uAE08 \uC804\uAE4C\uC9C0 \uAC00\uC9C0\uACE0 \uC788\uC5C8\uB294\uB370..."
      background: {fileID: 0}
      nextIndex: -1
      choices: []
    - speaker: "\uD574\uC124"
      text: "\uB3C8\uC8FC\uBA38\uB2C8\uB97C \uC783\uC5B4\uBC84\uB824 \uAC00\uC9C4
        \uB3C8\uC758 30%\uB97C \uC783\uC5C8\uB2E4."
      background: {fileID: 0}
      nextIndex: -1
      choices:
      - choiceText: "\uC783\uC5B4\uBC84\uB838\uB2E4"
        nextIndex: -2
        effects:
        - {fileID: 2026090837}
    endEffects: []
  - eventName: "\uC774\uAC70... \uC88B\uC740\uAC74\uAC00?"
    background: {fileID: -3542734953459156508, guid: 028a5be028fda2c498aea0b9d399e234,
      type: 3}
    dialogues:
    - speaker: "\uD574\uC124"
      text: "\uD669\uAE08\uBE5B \uBB3C\uC57D \uD55C \uBCD1\uC774 \uB208\uC55E\uC5D0\uC11C
        \uBC18\uC9DD\uC774\uACE0 \uC788\uB2E4."
      background: {fileID: 0}
      nextIndex: -1
      choices: []
    - speaker: Player
      text: "\uB9C8\uC2DC\uBA74 \uC88B\uC740 \uC77C\uC774 \uC0DD\uAE38 \uAC83 \uAC19\uC740
        \uB290\uB08C\uC774 \uB4E4\uC5B4."
      background: {fileID: 0}
      nextIndex: -1
      choices: []
    - speaker: "\uD574\uC124"
      text: "\uBCD1\uC744 \uC5EC\uB294 \uC21C\uAC04 \uB2EC\uCF64\uD55C \uD5A5\uAE30\uAC00
        \uC8FC\uBCC0\uC5D0 \uD37C\uC84C\uB2E4."
      background: {fileID: 0}
      nextIndex: -1
      choices:
      - choiceText: "\uD68C\uBCF5 \uC544\uC774\uD15C\uC744 \uCC59\uAE34\uB2E4"
        nextIndex: -2
        effects:
        - {fileID: 2026090845}
    endEffects: []
  - eventName: "\uB3C4\uBC15\uC0B4\uC778\uB3C4\uBC15?"
    background: {fileID: -776536894745668459, guid: 59314ea6e12665547a5d685da5593c57,
      type: 3}
    dialogues:
    - speaker: "\uB3C4\uBC15\uC0AC"
      text: "\uB8F0\uB81B \uD55C \uBC88 \uC5B4\uB54C? \uC131\uACF5\uD558\uBA74 \uAC74
        \uB3C8\uC758 2.5\uBC30\uB97C \uB3CC\uB824\uC8FC\uC9C0."
      background: {fileID: 0}
      nextIndex: -1
      choices: []
    - speaker: Player
      text: "\uC2E4\uD328\uD558\uBA74 \uAC74 \uB3C8\uC740 \uC804\uBD80 \uC0AC\uB77C\uC9C0\uB294
        \uAC70\uAD70."
      background: {fileID: 0}
      nextIndex: -1
      choices: []
    - speaker: "\uB3C4\uBC15\uC0AC"
      text: "\uC704\uD5D8\uD574\uC57C \uB3C4\uBC15\uC774\uC9C0. 100\uCE69\uC744 \uAC78\uC5B4\uBCF4\uACA0\uB098?"
      background: {fileID: 0}
